{% import '_partials.j2' as P with context %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ lab.short }}{% endblock %}</title>
<meta name="description" content="{{ lab.hero }}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
<style>:root{--accent:{{ palette.accent }};--accent-strong:{{ palette.strong }};--accent-base:{{ palette.accent }};--accent-strong-base:{{ palette.strong }};--accent-light:{{ palette.light }};--accent-soft:{{ palette.soft }};--accent-soft-dark:{{ palette.softd }};}</style>
<script src="script.js"></script>
</head>
<body class="t-monograph">
<a class="skip" href="#main">Skip to content</a>
<div class="shell">
<div class="side-col">
<header class="site">
  <div class="nav">
    <a class="brand" href="index.html">{{ lab.short }}<small>{{ lab.pi.department }}<br>University of Michigan</small></a>
    {{ P.menu(pages, page) }}
  </div>
  <div class="side-foot">
    <p>{{ lab.pi.name }}, PI</p>
    <p><a href="mailto:{{ lab.pi.email }}">{{ lab.pi.email }}</a></p>
  </div>
</header>
</div>
<div class="content-col">
<main id="main">
{% block hero %}
<div class="pagehead"><div class="wrap">{% block pagehead %}{% endblock %}</div></div>
{% endblock %}
{% block content %}{% endblock %}
</main>
{{ P.footer(lab, variant, other_variant, template, year) }}
</div>
</div>
</body>
</html>
